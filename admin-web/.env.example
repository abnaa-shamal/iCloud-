# Public web-app settings of the Firebase project (Project settings -> Your apps -> Web app).
# These are NOT secrets (they ship inside every web app), but keep them out of the repo anyway:
# copy to .env.local, or set them as GitHub repository variables for CI.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
